# Local development -> copy to .env at the repo root, then fill in.
# Never commit the real file: .env, .env.stage and .env.prod are all gitignored.

# 50+ random characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Use token_urlsafe, NOT Django's get_random_secret_key: the default .env is
# also Docker Compose's variable-substitution file, so a '$' in the value is
# interpolated away and Django silently receives a mangled key.
DJANGO_SECRET_KEY=replace-me-with-a-url-safe-random-string

# 1 shows tracebacks in the browser. Never 1 outside local development.
DJANGO_DEBUG=1

# Comma-separated. Add this machine's LAN IP to show the app to a colleague.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# Origins allowed to send unsafe methods. Must include the scheme and port.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Secure/proxy flags — all off locally, because local is plain http.
DJANGO_SECURE_COOKIES=0
DJANGO_BEHIND_PROXY=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0

# MySQL runs natively on the Mac, not in a container.
# MYSQL_HOST must be host.docker.internal — inside the container "localhost"
# is the container itself, and nothing is listening there.
MYSQL_DATABASE=tasky_dev
MYSQL_USER=root
MYSQL_PASSWORD=your-local-mysql-password
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
