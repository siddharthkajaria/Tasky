# Production -> copy to .env.prod ON THE SERVER. Never on a laptop, never in git.
# Serves tasky.tailwebs.com: gunicorn behind Apache behind Cloudflare (proxied).

# Must be set. config/settings.py refuses to start with DEBUG=0 and no key,
# rather than silently signing sessions with the committed dev fallback.
DJANGO_SECRET_KEY=replace-me-with-a-url-safe-random-string

DJANGO_DEBUG=0

DJANGO_ALLOWED_HOSTS=tasky.tailwebs.com

# The browser's Origin is the https URL, which never matches a bare
# ALLOWED_HOSTS entry — without this every POST fails CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=https://tasky.tailwebs.com

# TLS terminates at Apache, so Django sees plain http and would refuse to set
# Secure cookies. BEHIND_PROXY=1 makes it trust X-Forwarded-Proto instead.
# Only ever set this when something upstream really does terminate TLS.
DJANGO_SECURE_COOKIES=1
DJANGO_BEHIND_PROXY=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000

# Production database on RDS, ap-south-1. Use a dedicated least-privilege user,
# never the RDS master account.
MYSQL_DATABASE=tasky_prod
MYSQL_USER=tasky_prod_user
MYSQL_PASSWORD=from-the-password-manager
MYSQL_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
MYSQL_PORT=3306
