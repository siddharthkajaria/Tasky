# Staging -> copy to .env.stage at the repo root.
# Staging runs on a developer's own Mac (via `make stage-up`) but points at the
# staging database on RDS. There is no staging server.

DJANGO_SECRET_KEY=replace-me-with-a-url-safe-random-string

# Off, so staging behaves like production: no tracebacks, real error pages.
DJANGO_DEBUG=0

# Staging is reached at http://localhost:8000 on the developer's machine.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Plain http on localhost, so secure cookies must stay OFF — a Secure cookie is
# not sent over http and sign-in would fail with no useful error.
DJANGO_SECURE_COOKIES=0
DJANGO_BEHIND_PROXY=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0

# Staging database on RDS, ap-south-1.
MYSQL_DATABASE=tasky_stage
MYSQL_USER=tasky_stage_user
MYSQL_PASSWORD=from-the-password-manager
MYSQL_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
MYSQL_PORT=3306
